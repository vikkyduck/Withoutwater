# Скопировать в /opt/withoutwater/.env (chmod 600), заполнить TG_*.
PORT=5020
# CF-Worker-прокси к Telegram (РФ-хостинг напрямую к api.telegram.org не ходит):
TELEGRAM_API_BASE=https://tg-proxy.ilya-not-h2o.workers.dev
# Токен бота из @BotFather и chat_id получателя — заполнить через set-tg.sh:
TG_BOT_TOKEN=
TG_CHAT_ID=
LEADS_FILE=/opt/withoutwater/data/leads.jsonl
ALLOWED_ORIGIN=https://withoutwater.ru
